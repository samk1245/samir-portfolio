# ==========================================
# Samir Portfolio — Environment Configuration
# ==========================================

# Resend API Key for live email dispatch in /api/contact
# Get your free key at https://resend.com
RESEND_API_KEY=

# Verified email address where contact messages should be delivered
CONTACT_EMAIL=samir.dev@example.com

# Set to true to log submissions without dispatching real emails in development
ALLOW_DEMO_SUBMISSIONS=true

# Optional GitHub personal access token (increases rate limit for GitHub API endpoint)
GITHUB_PAT=

# Optional custom GitHub username for dynamic repository sync
NEXT_PUBLIC_GITHUB_USERNAME=
